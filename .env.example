# ─────────────────────────────────────────────────────────────
# Portal IT / Sistemas — Variables de entorno
# Copia este archivo como .env.local y completa los valores reales.
# NUNCA subas .env.local a Git.
# ─────────────────────────────────────────────────────────────

# SUPABASE — Obtenlos en: Project Settings → API
VITE_SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"

# Clave pública anónima (anon/public) — es seguro exponerla en el cliente
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ─────────────────────────────────────────────────────────────
# GEMINI (Agente IT por Voz)
# IMPORTANTE: SIN prefijo VITE_. Esta clave es SOLO de servidor y la usa
# la función serverless /api/parse-voice (y el plugin de dev de Vite).
# NUNCA uses VITE_GEMINI_API_KEY: expondría la clave en el bundle público.
# Obtén la clave en https://aistudio.google.com/apikey
# (Google emite claves con prefijo AIzaSy... o AQ.Ab... — ambas válidas).
# En producción, configúrala en Vercel → Settings → Environment Variables.
GEMINI_API_KEY="tu-clave-de-google-ai-studio"

# ─────────────────────────────────────────────────────────────
# ONESIGNAL (Notificaciones Push)
# La REST API Key es SOLO de servidor (sin prefijo VITE_): la usa
# la función serverless /api/send-push. Configúrala en Vercel.
# Obténla en: OneSignal → Settings → Keys & IDs → REST API Key
ONESIGNAL_REST_KEY="os_v2_app_..."

# App ID de OneSignal (público, se puede exponer en el cliente).
# Ya está embebido en el código; esta variable es opcional/override.
VITE_ONESIGNAL_APP_ID="d1338b94-ffbe-4c72-8a96-b9ca075f7147"
